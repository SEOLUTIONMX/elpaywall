---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import '../styles/global.css';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  SITE_LANG,
  PUBLISHER_NAME,
  SOCIAL,
} from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const props = Astro.props;

const sameAs = [SOCIAL.instagram, SOCIAL.tiktok, SOCIAL.x].filter(Boolean);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#org`,
  name: PUBLISHER_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  ...(sameAs.length ? { sameAs } : {}),
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_TITLE,
  url: SITE_URL,
  inLanguage: 'es-MX',
  publisher: { '@id': `${SITE_URL}/#org` },
};
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <BaseHead
      title={props.title}
      description={props.description}
      image={props.image}
      type={props.type}
      publishedTime={props.publishedTime}
      modifiedTime={props.modifiedTime}
      noindex={props.noindex}
    />
    <JsonLd schema={[orgSchema, siteSchema]} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 1rem;
        top: 0.5rem;
        background: var(--bg);
        padding: 0.5rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        z-index: 20;
      }
      main {
        padding-block: 2.5rem;
      }
    </style>
  </body>
</html>
