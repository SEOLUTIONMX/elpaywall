---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_URL, SITE_TITLE, AUTHOR_NAME, PUBLISHER_NAME } from '../consts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  heroAlt?: string;
  tags?: string[];
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroAlt,
  tags = [],
  slug,
} = Astro.props;

const url = `${SITE_URL}/blog/${slug}`;
const image = new URL(heroImage ?? '/og-default.png', SITE_URL).toString();

const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}/#article`,
  headline: title,
  description,
  image,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'es-MX',
  author: { '@type': 'Organization', name: AUTHOR_NAME, url: SITE_URL },
  publisher: { '@id': `${SITE_URL}/#org` },
  isPartOf: { '@id': `${SITE_URL}/#website` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Guías', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
>
  <JsonLd schema={[postSchema, breadcrumbSchema]} slot="head" />

  <article class="wrap post">
    <nav class="crumbs" aria-label="Ruta">
      <a href="/">Inicio</a> <span>/</span> <a href="/blog">Guías</a>
    </nav>

    <header>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="post-meta">
        <FormattedDate date={pubDate} />
        {updatedDate && <span> · actualizado <FormattedDate date={updatedDate} /></span>}
      </p>
    </header>

    {
      heroImage && (
        <img class="hero" src={heroImage} alt={heroAlt ?? title} width="880" height="495" />
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <p class="tags">
          {tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </p>
      )
    }

    <hr />
    <p class="back"><a href="/blog">← Todas las guías</a></p>
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: 1rem;
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--muted);
    font-family: var(--font-sans);
    margin-bottom: 1.5rem;
  }
  .crumbs span {
    margin: 0 0.4rem;
  }
  .post-meta {
    font-size: 0.9rem;
    color: var(--muted);
    font-family: var(--font-sans);
  }
  .hero {
    border-radius: 10px;
    margin: 1.5rem 0 2rem;
    border: 1px solid var(--border);
  }
  .prose :global(h2) {
    scroll-margin-top: 5rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.1rem 0;
  }
  .prose :global(li) {
    margin: 0.35rem 0;
  }
  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    color: var(--muted);
  }
  .back {
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }
</style>
