---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_URL, AUTHOR_NAME } from '../consts';

interface FaqItem {
  q: string;
  a: string;
}
interface SourceItem {
  label: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  heroAlt?: string;
  tags?: string[];
  slug: string;
  faq?: FaqItem[];
  sources?: SourceItem[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroAlt,
  tags = [],
  slug,
  faq = [],
  sources = [],
} = Astro.props;

const url = `${SITE_URL}/blog/${slug}`;
const image = new URL(heroImage ?? '/og-default.png', SITE_URL).toString();

const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}/#article`,
  headline: title,
  description,
  image,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'es-MX',
  author: { '@type': 'Organization', name: AUTHOR_NAME, url: SITE_URL },
  publisher: { '@id': `${SITE_URL}/#org` },
  isPartOf: { '@id': `${SITE_URL}/#website` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
  ...(sources.length
    ? { citation: sources.map((s) => ({ '@type': 'CreativeWork', name: s.label, url: s.url })) }
    : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Guías', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};

const faqSchema =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': `${url}/#faq`,
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const schemas = [postSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
>
  <JsonLd schema={schemas} slot="head" />

  <article class="wrap post">
    <nav class="crumbs" aria-label="Ruta">
      <a href="/">Inicio</a> <span>/</span> <a href="/blog">Guías</a>
    </nav>

    <header>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="post-meta">
        <FormattedDate date={pubDate} />
        {updatedDate && <span> · actualizado <FormattedDate date={updatedDate} /></span>}
      </p>
    </header>

    {
      heroImage && (
        <img class="hero" src={heroImage} alt={heroAlt ?? title} width="880" height="495" />
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      faq.length > 0 && (
        <section class="faq">
          <h2>Preguntas rápidas</h2>
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )
    }

    {
      sources.length > 0 && (
        <section class="sources">
          <h2>De dónde salieron los datos</h2>
          <ul>
            {sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener nofollow">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
          <p class="disclaimer">
            Los precios y reglas cambian seguido. Las cifras son de referencia, a un
            tipo de cambio de 17 pesos por dólar (Banxico, agosto de 2026). Antes de
            decidir algo, revisa el dato vigente en la fuente y, para lo fiscal,
            consulta a un contador.
          </p>
        </section>
      )
    }

    {
      tags.length > 0 && (
        <p class="tags">
          {tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </p>
      )
    }

    <hr />
    <p class="back"><a href="/blog">← Todas las guías</a></p>
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: 1rem;
  }
  .post header h1 {
    font-size: clamp(2rem, 4.8vw, 2.75rem);
    line-height: 1.12;
    margin-bottom: 0.6rem;
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--muted);
    font-family: var(--font-sans);
    margin-bottom: 1.5rem;
  }
  .crumbs span {
    margin: 0 0.4rem;
  }
  .post-meta {
    font-size: 0.9rem;
    color: var(--muted);
    font-family: var(--font-sans);
  }
  .hero {
    border-radius: 10px;
    margin: 1.5rem 0 2rem;
    border: 1px solid var(--border);
  }
  .prose :global(h2) {
    scroll-margin-top: 5rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.1rem 0;
  }
  .prose :global(li) {
    margin: 0.35rem 0;
  }
  .prose :global(table) {
    font-size: 0.95rem;
  }

  .faq {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }
  .faq details {
    border-bottom: 1px solid var(--border);
    padding: 0.85rem 0;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .faq details p {
    margin: 0.7rem 0 0.2rem;
    color: var(--ink-soft);
  }

  .sources {
    margin-top: 2.5rem;
    background: var(--bg-soft);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
  }
  .sources h2 {
    margin-top: 0;
    font-size: 1.15rem;
  }
  .sources ul {
    margin: 0.5rem 0 1rem;
    padding-left: 1.1rem;
  }
  .sources li {
    font-size: 0.92rem;
    margin: 0.3rem 0;
  }
  .sources .disclaimer {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    color: var(--muted);
  }
  .back {
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }
</style>
