---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Guías"
  description="Todas las guías de El Paywall para vender contenido para adultos desde México: fotos de pies, OnlyFans, precios, cómo cobrar, el SAT y privacidad."
>
  <div class="wrap">
    <p class="eyebrow">Guías</p>
    <h1>Una duda a la vez</h1>
    <p class="lede">
      Cada guía responde algo concreto: qué plataforma usar, cómo poner precios,
      cómo sacar tu dinero, qué hacer con el SAT, cómo cuidarte. Empieza por la de
      arriba o ve directo a la que te interese.
    </p>

    {
      posts.length === 0 ? (
        <p>Todavía no hay guías publicadas.</p>
      ) : (
        posts.map((post) => (
          <PostCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))
      )
    }
  </div>
</BaseLayout>
