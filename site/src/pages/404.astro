---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Esta página no existe" noindex={true}>
  <div class="wrap">
    <p class="eyebrow">Error 404</p>
    <h1>Aquí no hay nada, y no hay suscripción que lo desbloquee</h1>
    <p class="lede">
      El enlace que seguiste no lleva a ningún lado. Regresa al inicio o date una
      vuelta por las guías.
    </p>
    <p><a class="btn" href="/">Ir al inicio →</a></p>
  </div>
</BaseLayout>
