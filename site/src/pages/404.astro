---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" noindex={true}>
  <div class="wrap">
    <p class="eyebrow">Error 404</p>
    <h1>Esta página está detrás de un paywall que no existe</h1>
    <p class="lede">
      El enlace que seguiste no lleva a ningún lado. Prueba desde el inicio o
      revisa las guías.
    </p>
    <p><a class="btn" href="/">Ir al inicio</a></p>
  </div>
</BaseLayout>
