---
import FormattedDate from './FormattedDate.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}
const { href, title, description, pubDate, tags = [] } = Astro.props;
---

<article class="card">
  <a href={href} class="card-link">
    <h2>{title}</h2>
    <p class="desc">{description}</p>
    <p class="meta">
      <FormattedDate date={pubDate} />
      {tags.length > 0 && <span class="dot">·</span>}
      {tags.slice(0, 2).join(' · ')}
    </p>
  </a>
</article>

<style>
  .card {
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--border);
  }
  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .card h2 {
    margin: 0 0 0.35rem;
    font-size: 1.4rem;
    color: var(--ink);
  }
  .card-link:hover h2 {
    color: var(--accent-ink);
  }
  .desc {
    margin: 0 0 0.6rem;
    color: var(--muted);
  }
  .meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    font-family: var(--font-sans);
  }
  .dot {
    margin: 0 0.35rem;
  }
</style>
