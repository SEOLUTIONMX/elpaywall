---
import { SITE_TITLE, SITE_TAGLINE, SOCIAL } from '../consts';
const year = new Date().getFullYear();
const socials = [
  SOCIAL.instagram && { label: 'Instagram', href: SOCIAL.instagram },
  SOCIAL.tiktok && { label: 'TikTok', href: SOCIAL.tiktok },
  SOCIAL.x && { label: 'X', href: SOCIAL.x },
  { label: 'RSS', href: '/rss.xml' },
].filter(Boolean) as { label: string; href: string }[];
---

<footer class="site-footer">
  <div class="wrap">
    <p class="name">{SITE_TITLE}<span class="dot">.</span></p>
    <p class="tag">{SITE_TAGLINE}</p>
    <nav aria-label="Redes">
      {socials.map((s) => <a href={s.href}>{s.label}</a>)}
    </nav>
    <p class="fine">
      © {year} {SITE_TITLE}. Contenido informativo. No es asesoría legal ni fiscal.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 5rem;
    padding: 3rem 0 3.5rem;
    background: var(--bg-soft);
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    margin: 0;
  }
  .name .dot {
    color: var(--accent);
  }
  .tag {
    color: var(--muted);
    margin: 0.2rem 0 1.2rem;
    max-width: 28rem;
  }
  nav {
    display: flex;
    gap: 1.1rem;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 1.4rem;
    flex-wrap: wrap;
  }
  .fine {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
  }
</style>
